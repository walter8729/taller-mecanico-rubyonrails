<% content_for :title, "Editar presupuesto" %>

<h1>Editar presupuesto — Orden N° <%= @orden_trabajo.id %></h1>

<%= render "shared/errors", model: @presupuesto %>

<%= form_with(model: @presupuesto, url: orden_trabajo_presupuesto_path(@orden_trabajo), method: :patch, class: "formulario") do |form| %>
  <div class="campo">
    <%= form.label :fecha, "Fecha" %>
    <%= form.date_field :fecha, class: "input" %>
  </div>
  <div class="campo">
    <%= form.label :monto_estimado, "Monto estimado" %>
    <%= form.number_field :monto_estimado, step: "0.01", min: 0, class: "input" %>
  </div>
  <div class="acciones">
    <%= form.submit "Guardar cambios", class: "btn btn-acento" %>
    <%= link_to "Volver", @orden_trabajo, class: "btn" %>
  </div>
<% end %>