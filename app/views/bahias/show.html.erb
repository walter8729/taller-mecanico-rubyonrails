<% content_for :title, "Bahía" %>

<h1>Bahía <%= @bahia.numero %></h1>

<div class="card">
  <p><strong>Número:</strong> <%= @bahia.numero %></p>
  <p><strong>Tipo:</strong> <%= @bahia.tipo.humanize %></p>
  <p><strong>Estado:</strong> <%= badge_estado(@bahia.estado) %></p>
</div>

<div class="acciones">
  <%= link_to "Editar", edit_bahia_path(@bahia), class: "btn" %>
  <%= link_to "Volver", bahias_path, class: "btn btn-secondary" %>
</div>