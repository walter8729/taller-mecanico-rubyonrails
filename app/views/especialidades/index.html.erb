<% content_for :title, "Especialidades" %>

<h1>Especialidades</h1>

<div class="acciones">
  <%= link_to "Nueva especialidad", new_especialidad_path, class: "btn btn-acento" %>
</div>

<table>
  <thead>
    <tr>
      <th>Nombre</th>
      <th>Descripción</th>
      <th>Estado</th>
      <th>Acciones</th>
    </tr>
  </thead>
  <tbody>
    <% @especialidades.each do |especialidad| %>
      <tr>
        <td><%= link_to especialidad.nombre, especialidad %></td>
        <td><%= especialidad.descripcion %></td>
        <td><%= badge_estado(especialidad.estado) %></td>
        <td class="acciones">
          <%= link_to "Editar", edit_especialidad_path(especialidad), class: "btn btn-sm btn-secondary" %>
          <%= button_to "Eliminar", especialidad, method: :delete, class: "btn btn-sm btn-peligro", form: { style: "display:inline" } %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>