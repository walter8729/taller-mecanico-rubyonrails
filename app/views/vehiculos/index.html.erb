<% content_for :title, "Vehículos" %>

<h1>Vehículos</h1>

<div class="acciones">
  <%= link_to "Nuevo vehículo", new_vehiculo_path, class: "btn btn-acento" %>
</div>

<table>
  <thead>
    <tr>
      <th>Cliente</th>
      <th>Placa</th>
      <th>Marca / Modelo</th>
      <th>Año</th>
      <th>Color</th>
      <th>Kilometraje</th>
      <th>Estado</th>
      <th>Acciones</th>
    </tr>
  </thead>
  <tbody>
    <% @vehiculos.each do |vehiculo| %>
      <tr>
        <td><%= vehiculo.cliente&.nombre_completo %></td>
        <td><%= link_to vehiculo.placa, vehiculo %></td>
        <td><%= vehiculo.marca %> <%= vehiculo.modelo %></td>
        <td><%= vehiculo.anio %></td>
        <td><%= vehiculo.color %></td>
        <td><%= vehiculo.kilometraje %></td>
        <td><%= badge_estado(vehiculo.estado) %></td>
        <td class="acciones">
          <%= link_to "Editar", edit_vehiculo_path(vehiculo), class: "btn btn-sm btn-secondary" %>
          <%= button_to "Eliminar", vehiculo, method: :delete, class: "btn btn-sm btn-peligro", form: { style: "display:inline" } %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>