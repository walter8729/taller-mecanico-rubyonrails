<%= form_with(model: mecanico, class: "card") do |form| %>
  <%= render "shared/errors", model: mecanico %>

  <div class="field">
    <%= form.label :nombre, "Nombre" %>
    <%= form.text_field :nombre %>
  </div>

  <div class="field">
    <%= form.label :apellido, "Apellido" %>
    <%= form.text_field :apellido %>
  </div>

  <div class="field">
    <%= form.label :telefono, "Teléfono" %>
    <%= form.text_field :telefono %>
  </div>

  <div class="field">
    <%= form.label :correo, "Correo" %>
    <%= form.text_field :correo %>
  </div>

  <div class="field">
    <%= form.label :especialidad_id, "Especialidad" %>
    <%= form.collection_select :especialidad_id, Especialidad.activas.order(:nombre), :id, :nombre, { prompt: "Seleccione una especialidad" } %>
  </div>

  <%= form.submit class: "btn" %>
<% end %>